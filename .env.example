# =================================================================
# Ismail Sabbar — Public Portfolio (PRD v3.1.0 §14.2)
# This app is READ-ONLY + lead insert. No admin secrets live here.
# =================================================================

# MySQL (read-only user except portfolio_leads INSERT)
PORTFOLIO_DB_HOST=127.0.0.1
PORTFOLIO_DB_PORT=3306
PORTFOLIO_DB_USER=portfolio_public
PORTFOLIO_DB_PASSWORD=your_mysql_password
PORTFOLIO_DB_NAME=imsabbar_portfolio

# Legacy local aliases accepted for compatibility (PORTFOLIO_* takes priority)
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=portfolio_public
# DB_PASSWORD=your_mysql_password
# DB_NAME=imsabbar_portfolio

# Revalidation secret shared with imsabbar OS
PORTFOLIO_REVALIDATE_SECRET=your-random-secret-here

# Dev-only: set to "true" to skip MySQL and render from `lib/sample-data.ts`.
# Never set this in production. Public API routes still 503 in this mode.
USE_SAMPLE_DATA=false

# Cloudflare Turnstile
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
TURNSTILE_DEV_BYPASS=1

# Lead privacy / abuse prevention
PORTFOLIO_IP_HASH_PEPPER=

# Notifications (Telegram + Resend)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
RESEND_FROM_EMAIL=Ismail Sabbar <noreply@imsabbar.com>
NOTIFICATION_EMAIL=contact@imsabbar.com

# Base URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CAL_EMBED_ALLOWED_ORIGINS=https://cal.com,https://app.cal.com

# File uploads
PORTFOLIO_UPLOAD_PATH=/home/<user>/uploads/portfolio/leads
PORTFOLIO_UPLOAD_URL=https://assets.imsabbar.com/portfolio
